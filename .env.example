# ================================================================
# GenAI Workshop - Environment Variables
# ================================================================
# Copy this file to .env and fill in your values
# 
# Command: cp .env.example .env
# ================================================================

# ================================================================
# OLLAMA (LOCAL MODELS - Primary Setup)
# ================================================================
# Using TinyLlama via Ollama for local inference (FREE, NO API KEY!)
# 
# Setup:
# 1. Download Ollama from https://ollama.ai/download
# 2. Start Ollama: ollama serve
# 3. Pull TinyLlama: ollama pull tinyllama
#
# That's it! All notebooks will work locally with no internet needed!
# 
# No environment variables needed - Ollama runs on localhost:11434 by default

# ================================================================
# OPTIONAL: Google Gemini API Key (if you want to use cloud models)
# ================================================================
# Get your FREE API key from: https://aistudio.google.com/app/apikey
# 
# Steps:
# 1. Go to https://aistudio.google.com
# 2. Sign in with your Google account
# 3. Click "Get API key" in the left sidebar
# 4. Create a new API key
# 5. Uncomment and paste below to use Gemini instead of Ollama
#
# GOOGLE_API_KEY=your-google-key-here

# ================================================================
# OPTIONAL: LangSmith (for observability in Session 4)
# ================================================================
# Create account and get key from: https://smith.langchain.com/
# LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key-here

# Enable tracing (set to "false" to disable)
LANGCHAIN_TRACING_V2=false

# Project name in LangSmith dashboard
# LANGCHAIN_PROJECT=genai-workshop

# ================================================================
# OPTIONAL: OpenAI API (if you want to use GPT models)
# ================================================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk_your-openai-key-here

# ================================================================
# OPTIONAL: Azure OpenAI
# ================================================================
# If using Azure OpenAI instead of OpenAI directly
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01

# ================================================================
# OPTIONAL: HuggingFace Hub Token
# ================================================================
# For downloading gated models (Llama 2, etc.)
# Get token from: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_your-token-here

# ================================================================
# OPTIONAL: Other API Keys
# ================================================================
# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-key

# Google AI (Gemini)
# GOOGLE_API_KEY=your-google-key

# Cohere
# COHERE_API_KEY=your-cohere-key

# ================================================================
# OPTIONAL: Search APIs (for real web search)
# ================================================================
# Tavily Search
# TAVILY_API_KEY=your-tavily-key

# Serper (Google Search)
# SERPER_API_KEY=your-serper-key

# ================================================================
# Notes:
# - Never commit this file with real keys to version control
# - Add .env to your .gitignore
# ================================================================
